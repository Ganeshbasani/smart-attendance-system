# Smart Attendance System — root environment (read by docker compose for
# ${VAR} substitution). Copy to .env and edit before starting the stack:
#
#   cp .env.example .env
#
# NEVER commit the .env file (it is gitignored).

# JWT signing key. The backend refuses to start with a placeholder or a
# key shorter than 32 chars when DEBUG=false (the default). Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-strong-random-secret

# Email assigned the admin role when that address registers.
ADMIN_EMAIL=your-admin-email@example.com

# Postgres password used by docker compose (db service + backend URL).
# The default below matches the original local-dev credentials; override
# it for anything non-local.
# POSTGRES_PASSWORD=attendance
