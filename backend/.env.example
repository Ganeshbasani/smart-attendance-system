# Smart Attendance System - Backend Environment
# Copy to .env and fill in real values. NEVER commit the .env file.

# ----- App -----
# Set DEBUG=true for local development. In production (DEBUG=false) the app
# refuses to start unless SECRET_KEY is strong (>= 32 chars, not a placeholder).
DEBUG=true

# ----- Security -----
# Generate a strong key, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
MIN_PASSWORD_LENGTH=8

# ----- Rate limiting (slowapi) -----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REGISTER=10/hour
RATE_LIMIT_ATTENDANCE=20/minute

# Admin email - this user is assigned the admin role on registration
ADMIN_EMAIL=your-admin-email@example.com

# ----- CORS (comma-separated origins allowed to call the API) -----
BACKEND_CORS_ORIGINS=http://localhost:3000

# ----- Database -----
# Local dev (default): SQLite. Leave unset to use the local SQLite file.
# DATABASE_URL=sqlite:///./attendance_system.db
# Production (PostgreSQL):
# DATABASE_URL=postgresql+psycopg2://attendance:attendance@db:5432/attendance

# ----- Face recognition (optional tuning) -----
# ArcFace model pack used for detection + embeddings. Enrolled rows record the
# pack they were computed with; only matching rows load into the recognition
# gallery. After changing this, users must re-register — check who is affected
# via GET /admin/face/model-status (admin token required).
# FACE_MODEL_PACK=buffalo_l
# Match/duplicate similarity thresholds (cosine). Measure false-accept /
# false-reject rates for YOUR photos before changing these:
#   python -m scripts.benchmark_thresholds --dataset path/to/labeled/photos
# FACE_MATCH_THRESHOLD=0.42
# FACE_DUPLICATE_THRESHOLD=0.50

# ----- Active liveness: direction-sign calibration (optional) -----
# The capture path mirrors frames (react-webcam `mirrored`), so the yaw sign
# of a correct head turn is convention-dependent. Direction enforcement
# (LIVENESS_REQUIRE_DIRECTION) ships off; the extents are logged on every
# attempt. Measure the convention from real logs and set the sign before
# enabling enforcement:
#   python -m scripts.calibrate_direction path/to/backend.log
# LIVENESS_REQUIRE_DIRECTION=false
# +1 = documented convention (default), -1 = mirrored capture (measured by
# the calibration script; see scripts/calibrate_direction.py).
# LIVENESS_DIRECTION_SIGN=1

# ----- Uploads -----
# Multipart image uploads larger than this are rejected with 413.
# MAX_UPLOAD_SIZE_MB=10
# Comma-separated content types accepted on image endpoints (415 otherwise).
# ALLOWED_IMAGE_CONTENT_TYPES=image/jpeg,image/png,image/webp

# ----- Observability -----
# Correlation id header accepted/generated per request and echoed on responses.
# REQUEST_ID_HEADER=X-Request-ID
# Audit trail of auth/admin/face/attendance actions (table: audit_logs).
# AUDIT_LOG_ENABLED=true

# ----- Notifications -----
# In-app notifications (leave/correction decisions, shift changes). Rows are
# scoped to one user; a notification failure never breaks the operation that
# triggered it.
NOTIFICATIONS_ENABLED=true
# Optional email copy of each notification. Off by default. Sending is
# best-effort and synchronous (no task queue in this stack); failures are
# logged and never raised to the caller. No credentials are stored anywhere
# but these environment variables.
EMAIL_NOTIFY_ENABLED=false
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=notifications@example.com
# SMTP_PASSWORD=use-a-secret-manager-or-app-password
# Envelope sender; defaults to SMTP_USERNAME when empty.
# SMTP_FROM=notifications@example.com
# SMTP_TLS=true
# SMTP_TIMEOUT_SECONDS=5

# ----- Attendance anti-replay (optional tuning) -----
# Minimum number of distinct live frames required to mark attendance, and the
# minimum mean per-pixel difference required between them (blocks submitting
# the same still image repeatedly). Lower MIN_FRAME_DIFF if legitimate marks
# are rejected on very static/low-noise cameras.
# ATTENDANCE_MIN_FRAMES=2
# ATTENDANCE_MIN_FRAME_DIFF=0.75
